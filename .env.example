# Copy to .env; never commit the populated file. Node 24+ required.
MAXIMO_MODE=simulation
MAXIMO_CONNECTOR_MODE=browser
MAXIMO_READ_ONLY=false
MAXIMO_PRODUCTION_WRITE_ENABLED=false
MAXIMO_AUTH_MODE=apikey
# MAXIMO_BASE_URL=https://authorized-test.example/maximo/
# MAXIMO_API_KEY=
MAXIMO_SITE_IDS=
# MAXIMO_MAPPING_FILE=/absolute/private/path/sbgmax-mapping.json
# MAXIMO_BROWSER_STATE=/absolute/private/path/.auth/maximo.json
DATABASE_URL=data/operator.sqlite
SIMULATOR_DATABASE_URL=data/simulator.sqlite
SIMULATOR_BASE_URL=http://127.0.0.1:3002
HOST=127.0.0.1
PORT=3001
SIMULATOR_PORT=3002
APP_ORIGIN=http://127.0.0.1:5173
# Optional: server-local strong password; mandatory (>=16 chars) in live modes.
# OPERATOR_PASSWORD=
AI_PROVIDER=deterministic
AI_MODEL=
AI_EXTERNAL_DATA_ALLOWED=false
# AI_BASE_URL=https://enterprise-approved-provider.example/v1
# AI_API_KEY=
# Optional local optimization service. Fallback works without Python.
# OPTIMIZER_URL=http://127.0.0.1:8000
# BROWSER_EXECUTABLE=/usr/bin/chromium
